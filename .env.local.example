# Base URL of the PHP backend (see /backend). Point this at wherever
# backend/api/enquiries.php is deployed. No trailing slash.
#
# Local development (PHP built-in server from the backend/ folder):
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
#
# Production, if the backend sits at https://musicgurukula.com/backend:
# NEXT_PUBLIC_API_URL=https://musicgurukula.com/backend/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
